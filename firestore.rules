rules_version = '2';

// Security rules for Doc ID Desk.
// Publish these in the Firebase console: Firestore Database > Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Any login that has an email address.
    function authed() {
      return request.auth != null && request.auth.token.email != null;
    }
    // A login whose email address is proven (Google, or an emailed sign-in link).
    function signedIn() {
      return authed() && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function memberPath() { return /databases/$(database)/documents/members/$(myEmail()); }
    // On the People list, and either the email is proven or this is the exact
    // password login an administrator created for them (its id is stored as uid).
    function isMember() {
      return authed() && exists(memberPath())
        && (request.auth.token.email_verified == true
            || get(memberPath()).data.get('uid', '') == request.auth.uid);
    }
    function isAdmin() { return isMember() && get(memberPath()).data.role == 'admin'; }

    // One-time setup: the first person to sign in may make themselves administrator,
    // and only while no one has done so yet.
    match /config/setup {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/config/setup)
        && request.resource.data.ownerEmail == myEmail();
    }

    // Other settings (document types). Everyone reads; administrators change.
    match /config/{doc} {
      allow read: if isMember();
      allow write: if isAdmin() && doc != 'setup';
    }

    // People allowed to use the app. Document id = lower-case email address.
    match /members/{email} {
      allow get: if authed() && (email == myEmail() || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (signedIn()
            && email == myEmail()
            && request.resource.data.role == 'admin'
            && !exists(/databases/$(database)/documents/config/setup)
            && getAfter(/databases/$(database)/documents/config/setup).data.ownerEmail == myEmail());
      allow update, delete: if isAdmin() && email != myEmail();
    }

    // Username → login lookup, so people sign in with a username instead of an email.
    // Anyone may look up one username (needed before signing in); only administrators
    // can list or change them. Knowing a username is useless without its password.
    match /logins/{username} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    // Categories and their pools of Doc IDs: administrators only.
    match /categories/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /pool/{id} {
      allow read: if isMember();
      allow create: if isAdmin();
      allow update, delete: if false;   // a loaded pool is never edited
    }

    // Allocation pointer per category: it can only ever move forward,
    // so no Doc ID can be handed out a second time.
    match /alloc/{catId} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.next is int && request.resource.data.next >= 0;
      allow update: if isMember() && request.resource.data.next is int
        && request.resource.data.next >= resource.data.next;
      allow delete: if false;
    }

    // Assignment ledger (the audit trail). Never deleted.
    match /rec/{id} {
      allow read: if isMember();
      allow create: if isMember();
      allow update: if isMember() && request.resource.data.catId == resource.data.catId;
      allow delete: if false;
    }
  }
}
